# Copy to .env (never committed) and fill in your own values. Names only here: every value is empty.
# With Docker Compose, an empty value means the local default from docker-compose.yml.

# Database
DATABASE_URL=
POSTGRES_PASSWORD=

# Session secret (used from the authentication issue onwards)
SESSION_SECRET=

# Instance mode: self_hosted (the default when empty) or hosted
INSTANCE_MODE=

# Local administrator, created on first start only (when the database has no user).
# Both are required on first start; changing them later changes nothing.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# LLM provider API keys (none is needed to start the system)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
PERPLEXITY_API_KEY=
