# Copy to .env (never committed) and fill in your own values. Names only here: every value is empty.
# With Docker Compose, an empty value means the local default from docker-compose.yml.

# Database
DATABASE_URL=
POSTGRES_PASSWORD=

# Instance mode: self_hosted (the default when empty) or hosted
INSTANCE_MODE=

# Local administrator, created on first start only (when the database has no user).
# Both are required on first start; changing them later changes nothing. With Docker Compose,
# empty values mean the local-only defaults (admin@localhost); set your own outside local use.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Per-run cost budget in EUR (a number above 0, at most 100000); a run that reaches it ends partial.
# Empty with Docker Compose: the local default (5).
RUN_BUDGET_EUR=

# Public page named in the crawler's User-Agent (http or https); the worker needs it.
# Empty with Docker Compose: a local placeholder.
CRAWLER_CONTACT_URL=

# Approved provider configurations (JSON file). Empty: the shipped example, in which every
# configuration is disabled until verified (backend/app/providers/provider_configs.example.json).
# Never put a key in that file.
PROVIDER_CONFIG_FILE=

# LLM provider API keys, read by name (none is needed to start the system; GET /health names the
# ones the selected configurations need)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
PERPLEXITY_API_KEY=

# Observability (README, "Observability"). Empty endpoint: telemetry export is off.
OTEL_EXPORTER_OTLP_ENDPOINT=
TELEMETRY_EXPORT_TIMEOUT_SECONDS=
# Longest database statement, in seconds (default 30)
DATABASE_STATEMENT_TIMEOUT_SECONDS=
