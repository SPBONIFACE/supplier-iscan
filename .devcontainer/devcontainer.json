{
  "name": "Supplier iScan",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils@sha256:e76a6a8a35d1ad824daad1540725e0ec9f8ed2dc00d2850e990a9830013c7d08": {
      "username": "vscode",
      "installZsh": false,
      "installOhMyZsh": false,
      "installOhMyZshConfig": false,
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/node@sha256:2a19d3b0b3879437637cfd292eb29fee0afcfbe6364e33db9afc4f80c5c1f956": {
      "version": "24.22.1",
      "pnpmVersion": "none"
    },
    "ghcr.io/devcontainers/features/docker-in-docker@sha256:fae40f3c8be5a7c3b0db344c1d30341bc2c91ba38d1d5b14cd2ad72e6d65d084": {
      "moby": false
    }
  },
  "remoteUser": "vscode",
  "runArgs": ["--add-host=db:127.0.0.1"],
  "containerEnv": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
    "DATABASE_URL": "postgresql://supplier_iscan:supplier_iscan_local@db:5432/supplier_iscan"
  },
  "remoteEnv": {
    "CORS_ALLOWED_ORIGINS": "https://${containerEnv:CODESPACE_NAME}-5173.${containerEnv:GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN},http://localhost:5173"
  },
  "onCreateCommand": "sh .devcontainer/on-create.sh",
  "postCreateCommand": "make install",
  "postStartCommand": "sh .devcontainer/post-start.sh",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": {
      "label": "Frontend",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "API",
      "onAutoForward": "silent"
    },
    "5432": {
      "label": "Database (not forwarded)",
      "onAutoForward": "ignore"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "Optional. Anthropic API key; the project runs and tests without it."
    },
    "GEMINI_API_KEY": {
      "description": "Optional. Google Gemini API key; the project runs and tests without it."
    },
    "OPENAI_API_KEY": {
      "description": "Optional. OpenAI API key; the project runs and tests without it."
    },
    "MISTRAL_API_KEY": {
      "description": "Optional. Mistral API key; the project runs and tests without it."
    },
    "PERPLEXITY_API_KEY": {
      "description": "Optional. Perplexity API key; the project runs and tests without it."
    }
  }
}
