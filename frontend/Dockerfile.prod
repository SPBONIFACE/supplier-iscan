# Frontend production image: the built single-page application served by nginx on port 8080.
# One image for every environment. The browser calls /api on this same server; nginx forwards to the API at
# the address given at run time (API_UPSTREAM_URL), never built in.
# No secret and no data file is copied in.
FROM node:24.22.1-trixie-slim@sha256:43b9ba1142b8dcf33fa8f922ca1be85714adc444e0586c7cf7726daaeabc1bea AS build

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    CI=true \
    VITE_API_BASE_URL=/api

RUN corepack enable pnpm \
    && mkdir /app \
    && chown node:node /app

USER node
WORKDIR /app

COPY --chown=node:node package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY --chown=node:node . .
RUN pnpm build

FROM nginxinc/nginx-unprivileged:1.29.3-alpine@sha256:5aea7cc516b419e3526f47dd1531be31a56a046cfe44754d94f9383e13e2ee99

# The start script writes conf.d/default.conf from the template once API_UPSTREAM_URL is known.
USER root
RUN rm -f /etc/nginx/conf.d/default.conf && chown 101:0 /etc/nginx/conf.d && chmod 0775 /etc/nginx/conf.d
USER 101
COPY deploy/nginx.conf.template /etc/nginx/iscan/nginx.conf.template
COPY --chmod=0755 deploy/configure-proxy.sh /docker-entrypoint.d/40-configure-proxy.sh
COPY --from=build --chown=101:101 /app/dist /usr/share/nginx/html

EXPOSE 8080
