# Frontend server and gateway to the API (Cloud Run). Listens on 8080 (the image's unprivileged user).
# This is a TEMPLATE: the start script (40-configure-proxy.sh) fills the @...@ marks from the setting
# API_UPSTREAM_URL and writes /etc/nginx/conf.d/default.conf. Nothing about the API is built into the image.
#
# One address for the buyer: the browser only talks to this server. Every request under /api/ is forwarded
# to the API (the /api prefix is removed: the API serves at its root, as openapi.yaml says), so the session
# cookie belongs to one site.

# The access log line has the path only: never the query string, a cookie or any header (#51). The one
# secret that sits in a path, the invitation token, is replaced.
# ($uri is rewritten for the API, so the path comes from the request line, cut before any "?".)
map $request_uri $iscan_request_path {
  ~^(?<only_path>[^?]*) $only_path;
}
map $iscan_request_path $iscan_logged_path {
  ~^(?<head>/api/invitations/)[^/]+(?<tail>.*)$ "${head}[redacted]${tail}";
  default $iscan_request_path;
}
map $http_x_forwarded_proto $iscan_forwarded_proto {
  default $http_x_forwarded_proto;
  "" $scheme;
}
log_format iscan_path '$request_method $iscan_logged_path $status $body_bytes_sent ${request_time}s upstream=$upstream_status';

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  access_log /dev/stdout iscan_path;
  # Error lines quote the whole request line, query string included: only critical ones are written.
  # A failing API shows as 502 or 504 in the access log.
  error_log /dev/stderr crit;

  # The API's requests are short JSON bodies (its longest text field is 2000 characters).
  client_max_body_size 256k;

  # Names are looked up again while running (Cloud Run addresses can change), with the platform's resolver.
  resolver @RESOLVER@ valid=30s ipv6=off;

  # Hashed build files never change; the entry page is always re-read.
  # (nginx drops inherited add_header lines inside a location that sets its own, so each repeats them.)
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    try_files $uri =404;
  }

  # The API. /api/health goes to <upstream>/health. The slowest call is the PDF; the API's own limit is 300 s,
  # so nginx waits a little longer than that and the API answers first.
  location /api/ {
    set $iscan_upstream "@UPSTREAM_ORIGIN@";
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $iscan_upstream;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name @UPSTREAM_HOSTNAME@;
    proxy_set_header Host @UPSTREAM_HOST@;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $iscan_forwarded_proto;
    proxy_set_header Connection "";
    proxy_connect_timeout 10s;
    proxy_send_timeout 60s;
    proxy_read_timeout 330s;
  }

  # Single-page application: any other path is a client-side route.
  location / {
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    try_files $uri /index.html;
  }
}
